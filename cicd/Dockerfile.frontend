# Frontend image: the tracker is a single static page (no build step), served by
# nginx on port 80. Built from the repo root, so COPY paths are repo-relative.
# /api is routed to the backend by the ingress and never reaches nginx.
FROM nginx:stable-alpine
RUN apk upgrade --no-cache
COPY frontend/ /usr/share/nginx/html/
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
