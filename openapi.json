            "default": ""
          },
          "returnStatus": {
            "type": "string",
            "title": "Returnstatus",
            "default": "Pending"
          },
          "dateReturned": {
            "type": "string",
            "title": "Datereturned",
            "default": ""
          },
          "snipeit": {
            "type": "string",
            "title": "Snipeit",
            "default": ""
          },
          "win11": {
            "type": "string",
            "title": "Win11",
            "default": ""
          },
          "win11Version": {
            "type": "string",
            "title": "Win11Version",
            "default": ""
          },
          "remarks": {
            "type": "string",
            "title": "Remarks",
            "default": ""
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "dept": {
            "type": "string",
            "title": "Dept"
          },
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "updatedBy": {
            "type": "string",
            "title": "Updatedby"
          },
          "updatedAt": {
            "type": "string",
            "title": "Updatedat"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "dept",
          "order",
          "updatedBy",
          "updatedAt",
          "version"
        ],
        "title": "Laptop"
      },
